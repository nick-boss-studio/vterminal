#!/usr/bin/env node
/**
 * vterminal — AI CLI skill/command runner
 *
 * 透過 PTY 啟動 AI CLI（claude/codex/agy），自動執行指定的 skill 或 command，
 * 待回應輸出靜止 idle ms 後關閉 session。
 */

const pty = require("@homebridge/node-pty-prebuilt-multiarch");
const { Terminal } = require("@xterm/headless");
const { parseArgs } = require("node:util");
const {
  writeGitHubActionsOutput,
  writeGitHubActionsGroup,
  endGitHubActionsGroup
} = require("../lib/github-actions-output");

const { values, positionals } = parseArgs({
  args: process.argv.slice(2),
  options: {
    token: { type: "string", short: "t" },
    idle: { type: "string" },
    max: { type: "string" },
    bin: { type: "string" },
    help: { type: "boolean", short: "h" },
    version: { type: "boolean", short: "v" }
  },
  allowPositionals: true,
  strict: false
});

const { version: VTERMINAL_VERSION } = require("../package.json");

if (values.version) {
  console.log(VTERMINAL_VERSION);
  process.exit(0);
}

if (values.help || positionals.length === 0) {
  console.log(`
Usage:
  vterminal <command> [params]

Arguments:
  command  Skill or slash command name (without leading /)
  params   Arguments to pass to the command

Options:
  -t, --token    GitHub token (or set GH_TOKEN env var)
      --idle     Response idle timeout in ms (default: 60000)
      --max      Max total wait time in ms, 0 = unlimited (default: 600000)
      --bin      CLI executable name, resolved via PATH: claude/codex/agy (default: "claude")
  -h, --help     Show this help
  -v, --version  Print version

Examples:
  vterminal code-review https://github.com/owner/repo/pull/42
  vterminal code-review ultra 123
  vterminal run
  vterminal simplify
`);
  process.exit(values.help ? 0 : 1);
}

const command = positionals[0];
const params = positionals.slice(1).join(" ");
const claudeCommand = params ? `/${command} ${params}` : `/${command}`;

const token = values.token || process.env.GH_TOKEN || process.env.GH_PACKAGES_TOKEN;

if (command === "code-review" && !token) {
  console.error("Error: GitHub token required for code-review. Use --token or set GH_TOKEN env var.");
  process.exit(1);
}

const CLAUDE_BIN = values.bin || process.env.CLAUDE_BIN || "claude";

if (/[\\/]/.test(CLAUDE_BIN)) {
  console.error(`Error: --bin must be an executable name resolved via PATH, not a path ("${CLAUDE_BIN}").`);
  process.exit(1);
}
if (!/^(claude|codex|agy)$/i.test(CLAUDE_BIN)) {
  console.error(`Error: --bin must be one of claude/codex/agy, got "${CLAUDE_BIN}".`);
  process.exit(1);
}

writeGitHubActionsGroup(`vterminal: ${claudeCommand}`);
writeGitHubActionsOutput(`vterminal v${VTERMINAL_VERSION}`);
writeGitHubActionsOutput(`Running: ${claudeCommand}`);

const responseIdleMs = Number(values.idle || process.env.RESPONSE_IDLE_MS) || 60000;
const responseMaxMs = Number(values.max || process.env.RESPONSE_MAX_MS) || 600000;

let shouldCloseAfterIdle = false;
let didAutoClose = false;
let idleTimer = null;
let maxTimer = null;

const env = { ...process.env, TERM: "xterm-256color" };
if (token) env.GH_TOKEN = token;

const PTY_COLS = 140;
const PTY_ROWS = 40;

const shell = pty.spawn(CLAUDE_BIN, [], {
  name: "xterm-256color",
  cols: PTY_COLS,
  rows: PTY_ROWS,
  cwd: process.cwd(),
  env
});

// Claude 的 TUI 用游標定位（非單純換行）反覆重繪同一畫面（spinner、串流中的回應）。
// 直接把每個 PTY data chunk 當一行輸出會產生大量重繪雜訊；
// 用 headless terminal 模擬真實渲染結果，只有捲出畫面（已定案、不會再被重繪）的行才輸出。
const term = new Terminal({
  cols: PTY_COLS,
  rows: PTY_ROWS,
  scrollback: 10000,
  allowProposedApi: true
});

// Claude CLI 的忙碌狀態列（spinner + 經過時間 + token 數，如
// "✢ Thundering… (5s · ↓ 140 tokens)"）用「↓/↑ 數字 tokens」這個組合
// 當特徵字串辨識，比對到就整行包灰色，跟實際回應內容區隔開來。
const STATUS_LINE_RE = /[↓↑]\s*[\d.]+k?\s*tokens\b/;
const GRAY = "\x1b[90m";
const RESET = "\x1b[0m";

function emitLine(text) {
  const colored = STATUS_LINE_RE.test(text) ? `${GRAY}${text}${RESET}` : text;
  writeGitHubActionsOutput(colored, { preserveAnsi: true });
}

let flushedRow = 0;

function flushRows(upToExclusive) {
  const buffer = term.buffer.active;
  for (; flushedRow < upToExclusive; flushedRow++) {
    const line = buffer.getLine(flushedRow);
    emitLine(line ? line.translateToString(true) : "");
  }
}

function flushSettledRows() {
  flushRows(term.buffer.active.baseY);
}

function flushAllRows(callback) {
  // term.write() 內部以佇列非同步處理；送一次空字串等佇列清空後再讀 buffer，
  // 確保 flush 涵蓋所有已收到但尚未 parse 完成的資料。
  term.write("", () => {
    flushRows(term.buffer.active.length);
    if (callback) callback();
  });
}

// 只 flush 已捲出畫面的「定案」行會太安靜——很多回應在結束前都停在同一個
// viewport 內反覆重繪，不會捲動。用計時器定期預覽目前 viewport 的內容，
// 只印出跟上次預覽不同的行（用絕對行號比對，flushedRow 前進後自動清掉舊
// entry），讓過程中的回應看得到，又不會整段重複洗版。
const PREVIEW_INTERVAL_MS = 5000;
const lastPreviewByRow = new Map();
let previewTimer = null;

function previewLiveViewport() {
  const buffer = term.buffer.active;
  for (let i = flushedRow; i < buffer.length; i++) {
    const line = buffer.getLine(i);
    const text = line ? line.translateToString(true) : "";
    if (text && lastPreviewByRow.get(i) !== text) {
      emitLine(text);
      lastPreviewByRow.set(i, text);
    }
  }
  for (const rowIndex of lastPreviewByRow.keys()) {
    if (rowIndex < flushedRow) lastPreviewByRow.delete(rowIndex);
  }
}

shell.onData((data) => {
  if (process.stdout.isTTY) {
    process.stdout.write(data);
  } else {
    term.write(data, flushSettledRows);
  }
  if (shouldCloseAfterIdle) {
    scheduleIdleClose();
  }
});

if (!process.stdout.isTTY) {
  previewTimer = setInterval(previewLiveViewport, PREVIEW_INTERVAL_MS);
}

shell.onExit(({ exitCode }) => {
  clearTimeout(idleTimer);
  clearTimeout(maxTimer);
  clearInterval(previewTimer);
  const finish = () => {
    endGitHubActionsGroup();
    process.exit(didAutoClose ? 0 : (exitCode ?? 0));
  };
  if (process.stdout.isTTY) {
    finish();
  } else {
    flushAllRows(finish);
  }
});

function pasteAndSubmit(text) {
  shell.write("\x1b[200~");
  shell.write(text);
  shell.write("\x1b[201~");
  setTimeout(() => shell.write("\n"), 300);
  setTimeout(() => shell.write("\r"), 800);
}

function closeTerminal() {
  if (didAutoClose) return;
  shouldCloseAfterIdle = false;
  didAutoClose = true;
  clearTimeout(idleTimer);
  clearTimeout(maxTimer);
  writeGitHubActionsOutput("[auto-close] closing terminal...");
  try {
    shell.kill("SIGTERM");
  } catch (_) {}
}

process.on("SIGTERM", closeTerminal);
process.on("SIGINT", closeTerminal);

function scheduleIdleClose() {
  clearTimeout(idleTimer);
  idleTimer = setTimeout(() => {
    writeGitHubActionsOutput(`[auto-close] idle timeout reached (${responseIdleMs}ms)`);
    closeTerminal();
  }, responseIdleMs);
}

function closeWhenResponseIsIdle() {
  shouldCloseAfterIdle = true;
  writeGitHubActionsOutput(
    `[auto-close] waiting for idle (${responseIdleMs}ms), max (${responseMaxMs}ms)`
  );
  scheduleIdleClose();
  if (responseMaxMs > 0) {
    maxTimer = setTimeout(() => {
      writeGitHubActionsOutput(`[auto-close] max timeout reached (${responseMaxMs}ms)`);
      closeTerminal();
    }, responseMaxMs);
  }
}

setTimeout(() => {
  pasteAndSubmit(claudeCommand);
  setTimeout(closeWhenResponseIsIdle, 1200);
}, 8000);
